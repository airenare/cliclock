#!/bin/bash
# Resize + centre the Hyprland window hosting the calling cliclock so a COLS x ROWS grid fits
# with equal padding on all sides. Usage (called by cliclock via CLICLOCK_ON_SIZE): cliclock-fit-window COLS ROWS
# Metrics are calibrated for ghostty font-size 14 with window-padding 32px:
#   cell 11x22 px, fixed overhead 84 px per axis (2 x (32 padding + 10 ghostty)).
CELL_W=11 CELL_H=22 OVERHEAD=84
cols=$1 rows=$2
[ -n "$cols" ] && [ -n "$rows" ] || exit 1
# find the Hyprland window whose pid is an ancestor of this process
pid=$PPID
addr=
while [ "$pid" -gt 1 ]; do
  addr=$(hyprctl clients -j | jq -r --argjson p "$pid" '.[] | select(.pid==$p) | .address' | head -1)
  [ -n "$addr" ] && break
  pid=$(ps -o ppid= -p "$pid" | tr -d ' ')
  [ -n "$pid" ] || exit 1
done
[ -n "$addr" ] || exit 1
w=$((cols * CELL_W + OVERHEAD)) h=$((rows * CELL_H + OVERHEAD))
hyprctl dispatch "hl.dsp.window.resize({x=$w,y=$h,exact=true,window=\"address:$addr\"})" >/dev/null
hyprctl dispatch "hl.dsp.window.center({window=\"address:$addr\"})" >/dev/null
